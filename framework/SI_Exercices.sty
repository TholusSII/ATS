% Titres
\titleformat{\part}[display]{\centering\Huge\bfseries\color{SIblue}}{\partname\ \thepart}{1ex}{}
\titleformat{\chapter}[display]{\normalfont\huge\bfseries\color{SIblue}}{\filleft\Large\chaptertitlename\ \thechapter}{1ex}{\titlerule\vspace{1ex}}
\titleformat{\section}{\Large\bfseries\color{SIblue}}{\thesection}{0.8em}{}
\titleformat{\subsection}{\large\bfseries\color{SIblue}}{\thesubsection}{0.8em}{}
\setcounter{secnumdepth}{2}
\setcounter{tocdepth}{2}

% Listes
\setlist[itemize]{leftmargin=*,itemsep=2pt,topsep=3pt}
\setlist[enumerate]{leftmargin=*,itemsep=3pt,topsep=3pt}

% Modes historiques attendus par les sources xpessoles
\newif\ifprof
\newif\ifcorrection
\newif\ifnormal
\newif\ifdifficile
\newif\iftdifficile
\newif\iflivret
\newif\ifcolle
\proffalse
\correctionfalse
\normaltrue
\difficilefalse
\tdifficilefalse
\livrettrue
\collefalse

% Compteurs et environnements des exercices
\newcounter{question}
\NewDocumentCommand{\question}{g}{%
  \refstepcounter{question}%
  \par\medskip\noindent\textbf{Question \thequestion.}%
  \IfNoValueF{#1}{\quad #1}%
  \par\smallskip
}
\NewDocumentCommand{\exer}{m}{%
  \clearpage
  \section{#1}%
  \setcounter{question}{0}%
}
\NewDocumentCommand{\xpComp}{m m}{\fcolorbox{SIblue}{SIlightblue}{\scriptsize\bfseries #1--#2}}
\NewDocumentCommand{\UPSTIcompetence}{O{} m}{\fcolorbox{SIblue}{SIlightblue}{\scriptsize\bfseries #2}}

% Le corps est capturé par xparse : ces environnements fonctionnent donc aussi
% lorsqu'ils sont placés dans l'argument d'une commande, par exemple \marginnote.
\NewDocumentEnvironment{corrige}{+b}{%
  \ifprof
    \begin{tcolorbox}[enhanced,breakable,colback=SIgreen!4,colframe=SIgreen,title=Corrigé,fonttitle=\bfseries]
      #1
    \end{tcolorbox}%
  \fi
}{}
\NewDocumentEnvironment{solution}{+b}{%
  \ifprof
    \begin{tcolorbox}[enhanced,breakable,colback=SIgreen!4,colframe=SIgreen,title=Solution,fonttitle=\bfseries]
      #1
    \end{tcolorbox}%
  \fi
}{}

\newenvironment{obj}{\begin{tcolorbox}[enhanced,breakable,colback=SIlightblue,colframe=SIblue,title=Objectif,fonttitle=\bfseries]}{\end{tcolorbox}}
\newenvironment{rem}{\begin{tcolorbox}[enhanced,breakable,colback=SIorange!6,colframe=SIorange,title=Remarque,fonttitle=\bfseries]}{\end{tcolorbox}}
\newenvironment{marginfigure}[1][]{\begin{figure}[htbp]\centering}{\end{figure}}

