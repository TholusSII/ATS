\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{SI_Recueil}[2026/07/26 Adaptations pour le recueil global]
\RequirePackage{xparse}

% Les anciens exercices utilisent parfois des environnements et des conditionnels
% à l'intérieur de \marginnote. Cette construction était tolérée par leur mise en
% page kaobook, mais elle n'est pas robuste dans un assemblage de plusieurs centaines
% de fichiers. Le recueil global masque donc les notes de marge ; les sources de chaque
% exercice restent inchangées et continuent de les afficher lors d'une compilation isolée.
\RenewDocumentCommand{\marginnote}{o m o}{}

% Certains titres historiques contiennent une note de bas de page ou des conditionnels.
% Ils ne doivent donc pas être utilisés comme arguments mobiles de \section. Le recueil
% emploie un encadré non mobile, tout en conservant la numérotation, les labels et une
% entrée générique dans la table des matières.
\RenewDocumentCommand{\exer}{m}{%
  \clearpage
  \refstepcounter{section}%
  \addcontentsline{toc}{section}{\protect\numberline{\thesection}Exercice}%
  \markright{Exercice \thesection}%
  \begin{tcolorbox}[
    enhanced,
    breakable,
    colback=SIlightblue,
    colframe=SIblue,
    boxrule=0.8pt,
    arc=1.5mm,
    left=3mm,right=3mm,top=2mm,bottom=2mm
  ]
    {\Large\bfseries\color{SIblue}Exercice \thesection}\par\medskip
    {\large\bfseries #1}
  \end{tcolorbox}%
  \setcounter{question}{0}%
}

% Le compteur question est remis à zéro à chaque exercice. On rend l'ancre hyperref
% unique en lui ajoutant le numéro de section afin d'éviter les destinations dupliquées.
\renewcommand{\theHquestion}{\theHsection.\arabic{question}}
