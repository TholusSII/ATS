\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{TLCinematique}[2026/08/02 Outils de cinématique du solide]

\RequirePackage{xparse}
\RequirePackage{tikz}
\RequirePackage{amsmath}
\RequirePackage{mathtools}
\usetikzlibrary{arrows.meta,calc,angles,quotes,decorations.pathreplacing}

\tikzset{
  TLK axis/.style={->,thick,>=Latex},
  TLK vector/.style={->,very thick,TLCoverBlue,>=Latex},
  TLK secondary/.style={->,very thick,orange!85!black,>=Latex},
  TLK guide/.style={dashed,gray!70},
  TLK point/.style={circle,fill=black,inner sep=1.25pt},
}

% -----------------------------------------------------------------------------
% Écritures cinématiques
% -----------------------------------------------------------------------------
\NewDocumentCommand{\TLTorseurCinematique}{m m m}{%
  \ensuremath{%
    \left\{\mathcal{V}_{#1/#2}\right\}_{#3}
    =\left\{\begin{array}{c}
      \overrightarrow{\Omega}_{#1/#2}\\[1mm]
      \overrightarrow{V}_{#3\in #1/#2}
    \end{array}\right\}_{#3}%
  }%
}

\NewDocumentCommand{\TLChampVitesses}{m m m m}{%
  \ensuremath{%
    \overrightarrow{V}_{#2\in #1/#4}
    =\overrightarrow{V}_{#3\in #1/#4}
    +\overrightarrow{#2#3}\wedge\overrightarrow{\Omega}_{#1/#4}%
  }%
}

\NewDocumentCommand{\TLCompositionVitesses}{m m m m}{%
  \ensuremath{%
    \overrightarrow{V}_{#1\in #2/#4}
    =\overrightarrow{V}_{#1\in #2/#3}
    +\overrightarrow{V}_{#1\in #3/#4}%
  }%
}

\NewDocumentCommand{\TLCompositionRotations}{m m m}{%
  \ensuremath{%
    \overrightarrow{\Omega}_{#1/#3}
    =\overrightarrow{\Omega}_{#1/#2}
    +\overrightarrow{\Omega}_{#2/#3}%
  }%
}

\NewDocumentCommand{\TLDerivationVectorielle}{m m m}{%
  \ensuremath{%
    \left[\frac{\mathrm d\overrightarrow{#1}}{\mathrm dt}\right]_{#2}
    =\left[\frac{\mathrm d\overrightarrow{#1}}{\mathrm dt}\right]_{#3}
    +\overrightarrow{\Omega}_{#3/#2}\wedge\overrightarrow{#1}%
  }%
}

% -----------------------------------------------------------------------------
% Figures de changement de base
% #1 angle, #2 ancienne base, #3 nouvelle base, #4 valeur graphique de l'angle
% -----------------------------------------------------------------------------
\NewDocumentCommand{\TLChangementBasePlan}{O{\theta} O{0} O{1} O{28}}{%
  \begin{tikzpicture}[baseline=(current bounding box.center)]
    \coordinate (O) at (0,0);
    \draw[TLK axis] (O) -- (2.25,0) node[right] {$\vec{x}_{#2}$};
    \draw[TLK axis] (O) -- (0,2.25) node[above] {$\vec{y}_{#2}$};
    \draw[TLK secondary] (O) -- ({2.15*cos(#4)},{2.15*sin(#4)})
      node[right] {$\vec{x}_{#3}$};
    \draw[TLK secondary] (O) -- ({2.15*cos(90+#4)},{2.15*sin(90+#4)})
      node[above] {$\vec{y}_{#3}$};
    \draw[->,thick] (.78,0) arc[start angle=0,end angle=#4,radius=.78]
      node[midway,right] {$#1$};
    \node[below left] at (O) {$\vec{z}_{#2}=\vec{z}_{#3}$};
    \fill (O) circle (1.2pt);
  \end{tikzpicture}%
}

\NewDocumentCommand{\TLChangementBaseX}{O{\alpha} O{0} O{1} O{28}}{%
  \begin{tikzpicture}[baseline=(current bounding box.center)]
    \coordinate (O) at (0,0);
    \draw[TLK axis] (O) -- (2.25,0) node[right] {$\vec{y}_{#2}$};
    \draw[TLK axis] (O) -- (0,2.25) node[above] {$\vec{z}_{#2}$};
    \draw[TLK secondary] (O) -- ({2.15*cos(#4)},{2.15*sin(#4)})
      node[right] {$\vec{y}_{#3}$};
    \draw[TLK secondary] (O) -- ({2.15*cos(90+#4)},{2.15*sin(90+#4)})
      node[above] {$\vec{z}_{#3}$};
    \draw[->,thick] (.78,0) arc[start angle=0,end angle=#4,radius=.78]
      node[midway,right] {$#1$};
    \node[below left] at (O) {$\vec{x}_{#2}=\vec{x}_{#3}$};
    \fill (O) circle (1.2pt);
  \end{tikzpicture}%
}

\NewDocumentCommand{\TLChangementBaseY}{O{\beta} O{0} O{1} O{28}}{%
  \begin{tikzpicture}[baseline=(current bounding box.center)]
    \coordinate (O) at (0,0);
    \draw[TLK axis] (O) -- (2.25,0) node[right] {$\vec{z}_{#2}$};
    \draw[TLK axis] (O) -- (0,2.25) node[above] {$\vec{x}_{#2}$};
    \draw[TLK secondary] (O) -- ({2.15*cos(#4)},{2.15*sin(#4)})
      node[right] {$\vec{z}_{#3}$};
    \draw[TLK secondary] (O) -- ({2.15*cos(90+#4)},{2.15*sin(90+#4)})
      node[above] {$\vec{x}_{#3}$};
    \draw[->,thick] (.78,0) arc[start angle=0,end angle=#4,radius=.78]
      node[midway,right] {$#1$};
    \node[below left] at (O) {$\vec{y}_{#2}=\vec{y}_{#3}$};
    \fill (O) circle (1.2pt);
  \end{tikzpicture}%
}

% -----------------------------------------------------------------------------
% Produit vectoriel dans une base directe
% -----------------------------------------------------------------------------
\NewDocumentCommand{\TLProduitVectorielBase}{O{0}}{%
  \begin{center}
  \begin{tikzpicture}[>=Latex,baseline=(current bounding box.center)]
    \node[circle,draw=TLCoverBlue,minimum size=15mm,font=\bfseries] (x) at (90:1.65) {$\vec{x}_{#1}$};
    \node[circle,draw=TLCoverBlue,minimum size=15mm,font=\bfseries] (y) at (210:1.65) {$\vec{y}_{#1}$};
    \node[circle,draw=TLCoverBlue,minimum size=15mm,font=\bfseries] (z) at (330:1.65) {$\vec{z}_{#1}$};
    \draw[->,very thick,orange!85!black] (x) to[bend right=18] (y);
    \draw[->,very thick,orange!85!black] (y) to[bend right=18] (z);
    \draw[->,very thick,orange!85!black] (z) to[bend right=18] (x);
    \node at (0,0) {$\wedge$};
  \end{tikzpicture}

  \medskip
  $\vec{x}_{#1}\wedge\vec{y}_{#1}=\vec{z}_{#1}$,\quad
  $\vec{y}_{#1}\wedge\vec{z}_{#1}=\vec{x}_{#1}$,\quad
  $\vec{z}_{#1}\wedge\vec{x}_{#1}=\vec{y}_{#1}$.
  \end{center}%
}

% -----------------------------------------------------------------------------
% Cinématique du contact ponctuel
% -----------------------------------------------------------------------------
\NewDocumentCommand{\TLContactPonctuel}{}{%
  \begin{center}
  \begin{tikzpicture}[x=1.1cm,y=1.1cm,baseline=(current bounding box.center)]
    \draw[very thick,TLCoverBlue] (-2.5,.7) parabola bend (0,0) (2.5,.7);
    \draw[very thick,orange!85!black] (-2.2,2.2) parabola bend (0,0) (2.2,2.2);
    \draw[thick,gray!70] (-2.5,0)--(2.5,0) node[right] {plan tangent};
    \node[TLK point,label=below right:$I$] at (0,0) {};
    \node[TLCoverBlue] at (-1.8,.45) {solide 1};
    \node[orange!85!black] at (1.55,1.55) {solide 2};
    \draw[TLK vector] (0,0) -- (1.7,0) node[above] {$\vec V_{I\in2/1}$};
  \end{tikzpicture}
  \end{center}%
}

% -----------------------------------------------------------------------------
% Loi de vitesse trapézoïdale générique
% -----------------------------------------------------------------------------
\NewDocumentCommand{\TLLoiTrapeze}{O{$v_{\max}$}}{%
  \begin{center}
  \begin{tikzpicture}[x=1.05cm,y=1.0cm,baseline=(current bounding box.center)]
    \draw[TLK axis] (0,0) -- (6.65,0) node[right] {$t$};
    \draw[TLK axis] (0,0) -- (0,2.55) node[above] {$v$};
    \draw[TLK vector] (0,0) -- (1.4,2) -- (4.8,2) -- (6.1,0);
    \foreach \x/\lab in {1.4/t_1,4.8/t_2,6.1/t_3}{
      \draw[TLK guide] (\x,0) -- (\x,2);
      \node[below] at (\x,0) {$\lab$};
    }
    \node[left] at (0,2) {#1};
    \node[font=\scriptsize] at (.7,1.2) {accélération};
    \node[font=\scriptsize] at (3.1,2.25) {vitesse constante};
    \node[font=\scriptsize] at (5.5,1.2) {décélération};
  \end{tikzpicture}
  \end{center}%
}
