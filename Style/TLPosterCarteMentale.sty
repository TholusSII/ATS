\newcommand{\TLPosterCourseHeader}[3]{%
  \begin{tcolorbox}[
    enhanced,boxrule=0pt,arc=0pt,
    colback=TLPosterNavy,left=8mm,right=8mm,top=6mm,bottom=5mm,
    overlay={%
      \fill[TLPosterBlue] ([xshift=-18mm]frame.north east) circle[radius=20mm];
      \draw[white,line width=1.1pt] ([xshift=-18mm,yshift=-1mm]frame.north east) circle[radius=8mm];
      \draw[white,line width=.8pt] ([xshift=-18mm,yshift=-1mm]frame.north east) circle[radius=4mm];
      \draw[white,line width=.8pt] ([xshift=-28mm,yshift=-1mm]frame.north east)--([xshift=-8mm,yshift=-1mm]frame.north east);
      \draw[white,line width=.8pt] ([xshift=-18mm,yshift=-11mm]frame.north east)--([xshift=-18mm,yshift=9mm]frame.north east);
      \draw[white,line width=1.2pt,-{Stealth[length=3mm]}] ([xshift=-24mm,yshift=-8mm]frame.north east)--([xshift=-19mm,yshift=-2mm]frame.north east);
    }]
    \begin{minipage}{0.82\linewidth}
      {\color{white}\sffamily\bfseries\fontsize{29}{32}\selectfont #2}\par
      \vspace{1mm}
      {\color{white!88}\sffamily\fontsize{14}{17}\selectfont #3}\par
      \vspace{2mm}
      {\color{white!90}\sffamily\bfseries Chapitre #1\quad\textbar\quad Lycée Robert Doisneau -- ATS}
    \end{minipage}
  \end{tcolorbox}%
}

\newtcolorbox{TLPosterBloc}[2][]{
  enhanced,breakable,
  colback=white,colframe=#2,
  colbacktitle=#2,coltitle=white,
  title={#1},fonttitle=\sffamily\bfseries\Large,
  boxrule=.9pt,arc=2.5mm,
  left=4mm,right=4mm,top=3mm,bottom=3mm,
  attach boxed title to top left={xshift=4mm,yshift*=-\tcboxedtitleheight/2},
  boxed title style={arc=2mm,boxrule=0pt,left=4mm,right=4mm},
  drop fuzzy shadow,before skip=5mm,after skip=2mm
}

\newtcolorbox{TLPosterSavoirs}{
  enhanced,breakable,
  colback=TLPosterLight,colframe=TLPosterBlue,
  colbacktitle=TLPosterBlue,coltitle=white,
  title={Savoirs à maîtriser},fonttitle=\sffamily\bfseries\Large,
  boxrule=1.1pt,arc=3mm,left=5mm,right=5mm,top=3mm,bottom=3mm,
  attach boxed title to top left={xshift=4mm,yshift*=-\tcboxedtitleheight/2},
  boxed title style={arc=2mm,boxrule=0pt,left=4mm,right=4mm},
  drop fuzzy shadow
}

\newtcolorbox{TLPosterMethode}{
