}

\newcommand{\TLPosterKey}[2]{%
  \begin{tcolorbox}[enhanced,colback=white,colframe=TLPosterBlue,
    boxrule=1pt,arc=3mm,left=4mm,right=4mm,top=4mm,bottom=4mm,
    halign=center,drop fuzzy shadow]
    {\color{TLPosterNavy}\sffamily\bfseries\Large #1}\par\vspace{3mm}
    {\sffamily\large #2}
  \end{tcolorbox}%
}

\newcommand{\TLPosterRetenir}[1]{%
  \begin{tcolorbox}[enhanced,colback=TLPosterNavy,colframe=TLPosterNavy,
    boxrule=0pt,arc=3mm,left=6mm,right=6mm,top=4mm,bottom=4mm]
    \centering {\color{white}\sffamily\bfseries\Large À retenir : #1}
  \end{tcolorbox}%
}

