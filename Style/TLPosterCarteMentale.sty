% -----------------------------------------------------------------------------
% Carte mentale A3 paysage : composition fixe, robuste et lisible
% Les branches Savoirs et Méthode sont obligatoires dans la série.
% -----------------------------------------------------------------------------
\tikzset{
  TLmaproot/.style={ellipse,draw=TLPosterNavy,line width=1.8pt,fill=white,
    minimum width=7.2cm,minimum height=3.0cm,align=center,
    font=\sffamily\bfseries\fontsize{22}{25}\selectfont,text=TLPosterNavy,blur shadow},
  TLmaphead/.style={rounded corners=4mm,minimum width=4.7cm,minimum height=1.15cm,
    align=center,font=\sffamily\bfseries\Large,line width=1pt,blur shadow},
  TLmapcontent/.style={rounded corners=3mm,minimum width=6.1cm,minimum height=2.7cm,
    text width=5.5cm,align=left,font=\sffamily\small,line width=.8pt,inner sep=3mm},
  TLmapline/.style={line width=3.5pt,rounded corners=6mm},
  TLmapthin/.style={line width=1.1pt,rounded corners=4mm}
}

\newcommand{\TLMapBase}[2]{%
  \path[use as bounding box] (-19.2,-12.0) rectangle (19.2,12.0);
  \begin{scope}[on background layer]
    \fill[TLPosterBlue!3] (-19.2,-12.0) rectangle (19.2,12.0);
    \fill[TLPosterBlue!6] (-18,10.7) circle (1.2);
    \fill[TLPosterGreen!6] (17.8,10.5) circle (1.5);
    \fill[TLPosterTeal!6] (-17.8,-10.4) circle (1.5);
    \fill[TLPosterOrange!7] (17.7,-10.4) circle (1.5);
  \end{scope}
  \node[TLmaproot] (TLroot) at (0,0) {#1};
  \node[rounded corners=2mm,fill=TLPosterNavy,text=white,font=\sffamily\bfseries\small,
    inner xsep=4mm,inner ysep=1.5mm,align=center] at (0,-2.15) {#2};
}

\newcommand{\TLMapBranchTL}[2]{%
  \node[TLmaphead,draw=TLPosterBlue,fill=TLPosterLight,text=TLPosterNavy] (TLbA) at (-8.0,6.3) {#1};
  \node[TLmapcontent,draw=TLPosterBlue,fill=white,text=TLPosterNavy] (TLcA) at (-15.0,6.3) {#2};
  \draw[TLmapline,draw=TLPosterBlue] (TLroot.north west) to[out=145,in=-25] (TLbA.south east);
  \draw[TLmapthin,draw=TLPosterBlue] (TLbA.west) -- (TLcA.east);
}
\newcommand{\TLMapBranchTR}[2]{%
  \node[TLmaphead,draw=TLPosterGreen,fill=TLPosterGreenLight,text=TLPosterGreen!65!black] (TLbB) at (8.0,6.3) {#1};
  \node[TLmapcontent,draw=TLPosterGreen,fill=white,text=TLPosterGreen!60!black] (TLcB) at (15.0,6.3) {#2};
  \draw[TLmapline,draw=TLPosterGreen] (TLroot.north east) to[out=35,in=205] (TLbB.south west);
  \draw[TLmapthin,draw=TLPosterGreen] (TLbB.east) -- (TLcB.west);
}
\newcommand{\TLMapBranchML}[2]{%
  \node[TLmaphead,draw=TLPosterPurple,fill=TLPosterPurpleLight,text=TLPosterPurple] (TLbC) at (-9.0,0) {#1};
  \node[TLmapcontent,draw=TLPosterPurple,fill=white,text=TLPosterPurple!80!black] (TLcC) at (-15.5,0) {#2};
  \draw[TLmapline,draw=TLPosterPurple] (TLroot.west) -- (TLbC.east);
  \draw[TLmapthin,draw=TLPosterPurple] (TLbC.west) -- (TLcC.east);
}
\newcommand{\TLMapBranchMR}[2]{%
  \node[TLmaphead,draw=TLPosterOrange,fill=TLPosterOrangeLight,text=TLPosterOrange!75!black] (TLbD) at (9.0,0) {#1};
  \node[TLmapcontent,draw=TLPosterOrange,fill=white,text=TLPosterOrange!75!black] (TLcD) at (15.5,0) {#2};
  \draw[TLmapline,draw=TLPosterOrange] (TLroot.east) -- (TLbD.west);
  \draw[TLmapthin,draw=TLPosterOrange] (TLbD.east) -- (TLcD.west);
}
\newcommand{\TLMapBranchBL}[2]{%
  \node[TLmaphead,draw=TLPosterTeal,fill=TLPosterTealLight,text=TLPosterTeal!70!black] (TLbE) at (-8.0,-6.3) {#1};
  \node[TLmapcontent,draw=TLPosterTeal,fill=white,text=TLPosterTeal!70!black] (TLcE) at (-15.0,-6.3) {#2};
  \draw[TLmapline,draw=TLPosterTeal] (TLroot.south west) to[out=215,in=25] (TLbE.north east);
  \draw[TLmapthin,draw=TLPosterTeal] (TLbE.west) -- (TLcE.east);
}
\newcommand{\TLMapBranchBR}[2]{%
  \node[TLmaphead,draw=TLPosterOrange,fill=TLPosterOrangeLight,text=TLPosterOrange!75!black] (TLbF) at (8.0,-6.3) {#1};
  \node[TLmapcontent,draw=TLPosterOrange,fill=white,text=TLPosterOrange!75!black] (TLcF) at (15.0,-6.3) {#2};
  \draw[TLmapline,draw=TLPosterOrange] (TLroot.south east) to[out=325,in=155] (TLbF.north west);
  \draw[TLmapthin,draw=TLPosterOrange] (TLbF.east) -- (TLcF.west);
}
\newcommand{\TLMapRibbon}[1]{%
  \node[rounded corners=4mm,draw=TLPosterNavy,line width=1.1pt,fill=white,
    minimum width=14cm,minimum height=1.35cm,align=center,
    font=\sffamily\bfseries\normalsize,text=TLPosterNavy] at (0,-9.7) {#1};
}

