\newcommand{\TLRDMNavierBernoulli}{%
\begin{center}\begin{tikzpicture}[scale=.85]
\draw[very thick] (0,0)--(4.5,0);
\foreach \x in {.5,1.5,2.5,3.5,4.5}{\draw[thick] (\x,-.55)--(\x,.55);}
\node[below] at (2.25,-.8) {avant déformation};
\begin{scope}[xshift=6cm]
\draw[very thick] (0,0) .. controls (1.4,-.15) and (3.1,-.8) .. (4.5,-1.1);
\draw[thick,rotate around={-4:(.55,-.05)}] (.55,-.60)--(.55,.50);
\draw[thick,rotate around={-10:(1.55,-.22)}] (1.55,-.77)--(1.55,.33);
\draw[thick,rotate around={-15:(2.55,-.50)}] (2.55,-1.05)--(2.55,.05);
\draw[thick,rotate around={-18:(3.55,-.82)}] (3.55,-1.37)--(3.55,-.27);
\draw[thick,rotate around={-20:(4.45,-1.08)}] (4.45,-1.63)--(4.45,-.53);
\node[below] at (2.25,-1.75) {après déformation};
\end{scope}
\end{tikzpicture}\end{center}}

\newcommand{\TLRDMSuperposition}{%
