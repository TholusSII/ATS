\draw[very thick] (0,0)--(3,0);
\draw[->,thick] (1.5,1)--(1.5,.05) node[midway,right]{$F_1$};
\node at (3.7,0) {$+$};
\draw[very thick] (4.4,0)--(7.4,0);
\draw[->,thick] (6.6,1)--(6.6,.05) node[midway,right]{$F_2$};
\node at (8.1,0) {$=$};
\draw[very thick] (8.8,0)--(11.8,0);
\draw[->,thick] (10.3,1)--(10.3,.05) node[midway,right]{$F_1$};
\draw[->,thick] (11,1)--(11,.05) node[midway,right]{$F_2$};
\end{tikzpicture}\end{center}}

