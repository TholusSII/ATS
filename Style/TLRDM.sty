\ProvidesPackage{TLRDM}[2026/08/05 Outils graphiques du cours de RDM]
\RequirePackage{tikz}
\RequirePackage[most]{tcolorbox}
\usetikzlibrary{arrows.meta,calc,patterns,decorations.pathreplacing,positioning,babel}

\definecolor{TLRDMBlue}{RGB}{0,84,127}
\definecolor{TLRDMBlueBack}{RGB}{234,243,245}
\definecolor{TLRDMRed}{RGB}{170,45,45}
\definecolor{TLRDMRedBack}{RGB}{253,238,238}

\newenvironment{TLMethod}[1]
  {\begin{tcolorbox}[
    enhanced,breakable,
    colback=TLRDMBlueBack,colframe=TLRDMBlue,
    colbacktitle=TLRDMBlue,coltitle=white,
    fonttitle=\sffamily\bfseries,
    title={Méthode — #1},
    boxrule=.8pt,arc=1.5mm,
    left=4mm,right=4mm,top=2.5mm,bottom=3mm,
    before skip=1.1\baselineskip,after skip=1.1\baselineskip]}
  {\end{tcolorbox}}

\newenvironment{TLWarning}[1]
  {\begin{tcolorbox}[
    enhanced,breakable,
    colback=TLRDMRedBack,colframe=TLRDMRed,
    colbacktitle=TLRDMRed,coltitle=white,
    fonttitle=\sffamily\bfseries,
    title={Attention — #1},
    boxrule=.8pt,arc=1.5mm,
    left=4mm,right=4mm,top=2.5mm,bottom=3mm,
    before skip=1.1\baselineskip,after skip=1.1\baselineskip]}
  {\end{tcolorbox}}

% Environnement historique utilisé dans les cours Word convertis.
\newenvironment{objectifs}
  {\begin{TLMethod}{Objectifs du cours}}
  {\end{TLMethod}}

\newcommand{\TLPoutreReperee}{%
\begin{center}\begin{tikzpicture}[>=Latex,scale=.9]
\draw[fill=gray!10,very thick] (0,-.28) rectangle (8,.28);
\draw[dash pattern=on 4pt off 2pt] (0,0)--(8,0);
\draw[->] (0,-.85)--(1.4,-.85) node[right]{$\vec{x}$};
\draw[->] (0,-.85)--(0,.55) node[above]{$\vec{y}$};
\fill (0,0) circle (1.5pt) node[above left]{$A$};
\fill (8,0) circle (1.5pt) node[above right]{$B$};
\draw[dashed] (4,-.65)--(4,.65);
\node[above] at (4,.65) {section droite $S$};
\draw[decorate,decoration={brace,mirror,amplitude=4pt}] (0,-.5)--(8,-.5) node[midway,below=5pt]{$L$};
\end{tikzpicture}\end{center}}

