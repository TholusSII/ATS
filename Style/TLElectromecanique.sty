\ProvidesPackage{TLElectromecanique}[2026/08/04 Bibliotheque electromecanique]
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\RequirePackage{circuitikz}
\pgfplotsset{compat=1.18}
\usetikzlibrary{arrows.meta,positioning,calc,patterns,decorations.pathmorphing}

% Avec babel[french], le point-virgule peut être actif. PGFPlots l'utilise
% pourtant pour terminer chaque commande \addplot. On désactive donc les
% raccourcis français uniquement pendant les environnements axis.
\AtBeginEnvironment{axis}{%
  \ifdefined\shorthandoff
    \shorthandoff{:;!?}%
  \fi
}

% Circuitikz utilise également des caractères rendus actifs par babel[french]
% dans sa syntaxe interne. On les désactive uniquement dans cet environnement.
\AtBeginEnvironment{circuitikz}{%
  \ifdefined\shorthandoff
    \shorthandoff{:;!?}%
  \fi
}

\newcommand{\TLChaineConversionElectromecanique}{%
\begin{center}
\begin{tikzpicture}[>=Latex,node distance=9mm,
  bloc/.style={draw,rounded corners,minimum width=26mm,minimum height=11mm,align=center}]
\node[bloc] (alim) {Alimenter};
\node[bloc,right=of alim] (dist) {Distribuer};
\node[bloc,right=of dist] (conv) {Convertir\\machine};
\node[bloc,right=of conv] (trans) {Transmettre};
\node[bloc,right=of trans] (agir) {Agir};
\draw[->,thick] (alim)--(dist);
\draw[->,thick] (dist)--node[above]{énergie électrique}(conv);
\draw[->,thick] (conv)--node[above]{$C_u,\Omega_m$}(trans);
\draw[->,thick] (trans)--node[above]{énergie mécanique}(agir);
\draw[<->,very thick] ([yshift=-9mm]alim.south west)--node[below]{transfert direct ou inverse}([yshift=-9mm]agir.south east);
\end{tikzpicture}
\end{center}}

