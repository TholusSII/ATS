\newcommand{\TLModeleMoteurCC}{%
\begin{center}
\begin{circuitikz}[european resistors]
\draw (0,0) to[sV,l=$u$] (0,3)
      to[R,l=$R$] (2.5,3)
      to[L,l=$L$] (5,3)
      to[V,l_=$e=K_e\Omega$] (5,0) -- (0,0);
\draw[-Latex,thick] (6.2,2.7) arc[start angle=120,end angle=-180,radius=.8];
