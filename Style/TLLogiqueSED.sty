\newcommand{\TLPortesLogiques}{%
\begin{tikzpicture}[>=Latex,node distance=12mm,
  porte/.style={draw,rounded corners,minimum width=21mm,minimum height=10mm,align=center,font=\small\bfseries}]
\node[porte] (non) {NON};
\node[porte,right=of non] (et) {ET};
\node[porte,right=of et] (ou) {OU};
\node[porte,right=of ou] (xor) {OU exclusif};
\node[below=4mm of non] {$s=\overline a$};
\node[below=4mm of et] {$s=a\cdot b$};
\node[below=4mm of ou] {$s=a+b$};
\node[below=4mm of xor] {$s=a\oplus b$};
\end{tikzpicture}}

