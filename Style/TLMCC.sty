\node[bloc,right=of s1] (elec) {$\dfrac{1}{Lp+R}$};
\node[bloc,right=of elec] (kc) {$K_c$};
\node[somme,right=of kc] (s2) {$\Sigma$};
\node[bloc,right=of s2] (meca) {$\dfrac{1}{Jp+f}$};
\node[bloc,right=of meca] (ke) {$K_e$};
