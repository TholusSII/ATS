\draw[->] (s2)--(meca); \draw[->] (meca)--node[above]{$\Omega$}(ke);
\draw[->] (ke.south)|-++(0,-1.1)-|node[pos=.25,below]{$-$}(s1.south);
\draw[->] ($(s2)+(0,1.2)$)--node[right]{$-C_r$}(s2);
