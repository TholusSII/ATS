\newcommand{\TLOnduleurTriphas}{%
\begin{circuitikz}[american currents,european resistors,scale=.82,transform shape]
  \draw (0,3) -- (8,3) node[right]{$+U_{dc}/2$};
  \draw (0,-3) -- (8,-3) node[right]{$-U_{dc}/2$};
  \foreach \x/\lab in {1.2/a,4/b,6.8/c}{%
    \draw (\x,3) to[generic,l=$T_{\lab+}$] (\x,.35) -- ++(.7,0) node[right]{$v_{\lab N}$};
    \draw (\x,.35) to[generic,l=$T_{\lab-}$] (\x,-3);
    \draw (\x,.35) -- ++(.7,0) to[L,l=$L_{\lab}$] ++(1.2,0);
  }
  \node[align=center] at (4,4) {trois bras à commandes complémentaires};
\end{circuitikz}}

\newcommand{\TLCouplagesEtoileTriangle}{%
\begin{tikzpicture}[>=Latex,node distance=10mm]
  \node (t1) at (0,1.2) {$U_1$}; \node (t2) at (0,0) {$V_1$}; \node (t3) at (0,-1.2) {$W_1$};
  \node[circle,draw,inner sep=1.5pt] (n) at (2,0) {};
  \foreach \a in {t1,t2,t3}{\draw (\a)--(n);}
  \node at (1,-2){Couplage étoile};
  \begin{scope}[xshift=5cm]
    \coordinate (A) at (90:1.2); \coordinate (B) at (210:1.2); \coordinate (C) at (330:1.2);
    \draw (A)--(B)--(C)--cycle;
    \node[above] at (A) {$U$}; \node[below left] at (B) {$V$}; \node[below right] at (C) {$W$};
    \node at (0,-2){Couplage triangle};
  \end{scope}
\end{tikzpicture}}

