\newcommand{\TLTriphasageSimpleCompose}{%
\begin{tikzpicture}[>=Latex,scale=.82]
  \coordinate (O) at (0,0);
  \foreach \a/\n in {90/V_1,210/V_2,330/V_3}{\draw[->,thick,TLMAblue] (O)--(\a:2) node[pos=1.12]{$\underline{\n}$};}
  \draw[->,very thick,TLMAorange] (210:2)--(90:2) node[midway,left]{$\underline U_{12}$};
