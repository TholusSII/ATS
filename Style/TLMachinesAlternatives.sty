\NewTColorBox{TLMachineMethod}{m}{%
  enhanced,breakable,
  colback=TLMAblueback,colframe=TLMAblue,
  colbacktitle=TLMAblue,coltitle=white,
  fonttitle=\sffamily\bfseries,
  title={Méthode — #1},
  boxrule=.8pt,arc=1.5mm,
  left=4mm,right=4mm,top=2.5mm,bottom=3mm,
