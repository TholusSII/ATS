\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{TLCinematiqueSolide}[2026/08/02 Outils graphiques de cinématique du solide]

\RequirePackage{xparse}
\RequirePackage{tikz}
\RequirePackage{amsmath}
\usetikzlibrary{arrows.meta,calc,decorations.pathreplacing}

\tikzset{
  TLK axis/.style={->,thick,>=Latex},
  TLK vector/.style={->,very thick,TLCoverBlue,>=Latex},
  TLK secondary/.style={->,very thick,orange!85!black,>=Latex},
  TLK guide/.style={dashed,gray!70},
}

% Écriture compacte d'un torseur cinématique au point A.
\NewDocumentCommand{\TLTorseurCinematique}{m m m}{%
  \ensuremath{%
    \left\{\mathcal{V}_{#1/#2}\right\}_{#3}
    =\left\{\begin{array}{c}
      \overrightarrow{\Omega}_{#1/#2}\\[1mm]
      \overrightarrow{V}_{#3\in #1/#2}
    \end{array}\right\}_{#3}%
  }%
}

% Relation du champ des vecteurs vitesse.
\NewDocumentCommand{\TLChampVitesses}{m m m m}{%
  \ensuremath{%
    \overrightarrow{V}_{#2\in #1/#4}
    =\overrightarrow{V}_{#3\in #1/#4}
    +\overrightarrow{#2#3}\wedge\overrightarrow{\Omega}_{#1/#4}%
  }%
}

% Petit schéma de rotation plane entre deux bases.
\NewDocumentCommand{\TLChangementBasePlan}{O{\theta} O{0} O{1}}{%
  \begin{tikzpicture}[baseline=(current bounding box.center)]
    \coordinate (O) at (0,0);
    \draw[TLK axis] (O) -- (2.2,0) node[right] {$\vec{x}_{#2}$};
    \draw[TLK axis] (O) -- (0,2.2) node[above] {$\vec{y}_{#2}$};
    \draw[TLK secondary] (O) -- ({2.1*cos(28)},{2.1*sin(28)}) node[right] {$\vec{x}_{#3}$};
    \draw[TLK secondary] (O) -- ({2.1*cos(118)},{2.1*sin(118)}) node[above] {$\vec{y}_{#3}$};
    \draw[->,thick] (.75,0) arc[start angle=0,end angle=28,radius=.75]
      node[midway,right] {$#1$};
    \fill (O) circle (1.2pt);
  \end{tikzpicture}%
}

% Loi de vitesse trapézoïdale générique.
\NewDocumentCommand{\TLLoiTrapeze}{O{$v_{\max}$}}{%
  \begin{tikzpicture}[x=1.1cm,y=1.0cm,baseline=(current bounding box.center)]
    \draw[TLK axis] (0,0) -- (6.5,0) node[right] {$t$};
    \draw[TLK axis] (0,0) -- (0,2.5) node[above] {$v$};
    \draw[TLK vector] (0,0) -- (1.4,2) -- (4.8,2) -- (6.1,0);
    \foreach \x/\lab in {1.4/t_1,4.8/t_2,6.1/t_3}{
      \draw[TLK guide] (\x,0) -- (\x,2);
      \node[below] at (\x,0) {$\lab$};
    }
    \node[left] at (0,2) {#1};
  \end{tikzpicture}%
}
