\RequirePackage{xparse}
\RequirePackage{etoolbox}
\RequirePackage{adjustbox}
\RequirePackage{amsmath}
\RequirePackage{tikz}
\usetikzlibrary{positioning,calc,arrows.meta}

% Chargement direct des deux bibliothèques historiques utiles au chapitre.
% On évite volontairement Notations_SLCI, qui charge Notations_Maths et
% redéfinit plusieurs commandes déjà fournies par le framework TL.
\RequirePackage{schemabloc}
\RequirePackage{bodegraph}

\providecolor{TLCoverBlue}{RGB}{0,82,155}
\definecolor{TLSystemFill}{RGB}{238,245,251}
\definecolor{TLReturnFill}{RGB}{247,244,235}

\sbStyleBloc{rounded corners=1mm,fill=TLSystemFill,draw=TLCoverBlue!75,thick}
\sbStyleLien{thick,color=TLCoverBlue!85!black}
\sbStyleSum{fill=white,draw=TLCoverBlue!75,thick}

