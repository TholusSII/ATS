% ---------------------------------------------------------------------------
% Schéma-blocs
% ---------------------------------------------------------------------------
\newcommand{\TLCorrecteurSerie}{%
  \begin{center}
  \resizebox{.98\linewidth}{!}{%
  \begin{tikzpicture}[auto,font=\small]
    \sbEntree{E}
    \sbComp[4]{Comp}{E}
    \sbBlocL[4]{Cor}{Correcteur \(C(p)\)}{Comp}
    \sbBlocL[4]{Proc}{Procédé \(G(p)\)}{Cor}
    \sbSortie[4]{S}{Proc}
    \sbRelier[\(E(p)\)]{E}{Comp}
    \sbRelier[\(\varepsilon(p)\)]{Comp}{Cor}
    \sbRelier[\(U(p)\)]{Cor}{Proc}
    \sbRelier[\(S(p)\)]{Proc}{S}
    \node[sbStyleBloc,below=2.3em of Proc] (Cap) {Capteur \(H(p)\)};
    \draw[sbStyleLien] (Proc-S.south) |- (Cap.east);
    \draw[sbStyleLien] (Cap.west) -| node[pos=.27,below]{\(S_m(p)\)} (Comp.south);
    \node[font=\itshape,above=1.6em of Proc] (Pert) {Perturbation \(Q(p)\)};
    \draw[sbStyleLien] (Pert) -- (Proc.north);
  \end{tikzpicture}}
  \end{center}
}

\newcommand{\TLTroisActionsCorrection}{%
  \begin{center}
  \begin{minipage}[t]{.31\linewidth}
    \centering\textbf{Action P}\par\medskip
    \begin{tikzpicture}[auto,font=\scriptsize]
      \sbEntree{EP}\sbBlocL[3]{BP}{\(K\)}{EP}\sbSortie[3]{SP}{BP}
      \sbRelier[\(\varepsilon\)]{EP}{BP}\sbRelier[\(u\)]{BP}{SP}
    \end{tikzpicture}
    \[u(t)=K\varepsilon(t)\]
  \end{minipage}\hfill
  \begin{minipage}[t]{.31\linewidth}
    \centering\textbf{Action I}\par\medskip
    \begin{tikzpicture}[auto,font=\scriptsize]
      \sbEntree{EI}\sbBlocL[3]{BI}{\(\dfrac{1}{T_i p}\)}{EI}\sbSortie[3]{SI}{BI}
      \sbRelier[\(\varepsilon\)]{EI}{BI}\sbRelier[\(u\)]{BI}{SI}
    \end{tikzpicture}
    \[u(t)=\frac1{T_i}\int_0^t\varepsilon(\tau)\,d\tau\]
  \end{minipage}\hfill
  \begin{minipage}[t]{.31\linewidth}
    \centering\textbf{Action D}\par\medskip
    \begin{tikzpicture}[auto,font=\scriptsize]
      \sbEntree{ED}\sbBlocL[3]{BD}{\(T_d p\)}{ED}\sbSortie[3]{SD}{BD}
      \sbRelier[\(\varepsilon\)]{ED}{BD}\sbRelier[\(u\)]{BD}{SD}
    \end{tikzpicture}
    \[u(t)=T_d\frac{d\varepsilon}{dt}\]
  \end{minipage}
  \end{center}
}

\newcommand{\TLBouclesImbriquees}{%
  \begin{center}
  \resizebox{.99\linewidth}{!}{%
  \begin{tikzpicture}[auto,font=\small]
    \sbEntree{E}
    \sbComp[4]{Cpos}{E}
    \sbBlocL[4]{Kp}{Correcteur position}{Cpos}
    \sbComp[4]{Cvit}{Kp}
    \sbBlocL[4]{Kv}{Correcteur vitesse}{Cvit}
    \sbBlocL[4]{Mot}{Moteur}{Kv}
    \sbBlocL[4]{Int}{\(\dfrac{1}{p}\)}{Mot}
    \sbSortie[4]{S}{Int}
    \sbRelier[\(\Theta_c(p)\)]{E}{Cpos}
    \sbRelier{Cpos}{Kp}
    \sbRelier[\(\Omega_c(p)\)]{Kp}{Cvit}
    \sbRelier{Cvit}{Kv}
    \sbRelier{Kv}{Mot}
    \sbRelier[\(\Omega(p)\)]{Mot}{Int}
    \sbRelier[\(\Theta(p)\)]{Int}{S}
    \draw[sbStyleLien] (Mot-Int.south) |- ++(0,-1.6) -| node[pos=.25,below]{boucle interne} (Cvit.south);
    \draw[sbStyleLien] (Int-S.south) |- ++(0,-2.7) -| node[pos=.25,below]{boucle externe} (Cpos.south);
  \end{tikzpicture}}
  \end{center}
}

% ---------------------------------------------------------------------------
% Diagrammes de Bode des correcteurs
% Les abscisses sont x = log10(omega).
% ---------------------------------------------------------------------------
\NewDocumentCommand{\TLBodeCorrecteurP}{O{10}}{%
  \begin{center}
  \begin{tikzpicture}[x=1.7cm,y=.045cm]
    \UnitedB\OrdBode{20}\semilog*{-2}{2}{-40}{40}
    \draw[Bode lines,domain=-2:2] plot (\x,{20*ln(abs(#1))/ln(10)});
    \node[anchor=south west,font=\scriptsize] at (-1.9,{20*ln(abs(#1))/ln(10)}) {\(20\log_{10}K\)};
  \end{tikzpicture}
  \vspace{2mm}
  \begin{tikzpicture}[x=1.7cm,y=.025cm]
    \UniteDegre\OrdBode{45}\semilog*{-2}{2}{-90}{90}
    \draw[Bode lines] (-2,0) -- (2,0);
  \end{tikzpicture}
  \end{center}
}

\NewDocumentCommand{\TLBodeCorrecteurI}{O{1}}{%
  \begin{center}
  \begin{tikzpicture}[x=1.7cm,y=.04cm]
    \UnitedB\OrdBode{20}\semilog*{-2}{2}{-60}{60}
    \draw[Bode lines,domain=-2:2] plot (\x,{-20*(\x+ln(#1)/ln(10))});
    \draw[asymp lines,dashed] ({-ln(#1)/ln(10)},-60) -- ({-ln(#1)/ln(10)},60);
  \end{tikzpicture}
  \vspace{2mm}
  \begin{tikzpicture}[x=1.7cm,y=.025cm]
    \UniteDegre\OrdBode{45}\semilog*{-2}{2}{-180}{0}
    \draw[Bode lines] (-2,-90) -- (2,-90);
  \end{tikzpicture}
  \end{center}
}

\NewDocumentCommand{\TLBodeCorrecteurPI}{O{1} O{1}}{%
  \begin{center}
  \begin{tikzpicture}[x=1.7cm,y=.04cm]
    \UnitedB\OrdBode{20}\semilog*{-2}{2}{-60}{40}
    \draw[Bode lines,domain=-2:2,samples=140,smooth]
      plot (\x,{20*ln(abs(#1*sqrt(1+(#2*pow(10,\x))^2)/(#2*pow(10,\x))))/ln(10)});
    \draw[asymp lines,dashed] ({-ln(#2)/ln(10)},-60) -- ({-ln(#2)/ln(10)},40);
  \end{tikzpicture}
  \vspace{2mm}
  \begin{tikzpicture}[x=1.7cm,y=.025cm]
    \UniteDegre\OrdBode{45}\semilog*{-2}{2}{-180}{0}
    \draw[Bode lines,domain=-2:2,samples=140,smooth]
      plot (\x,{atan(#2*pow(10,\x))-90});
  \end{tikzpicture}
  \end{center}
}

\NewDocumentCommand{\TLBodeRetardPhase}{O{1} O{10} O{1}}{%
  \begin{center}
  \begin{tikzpicture}[x=1.7cm,y=.05cm]
    \UnitedB\OrdBode{20}\semilog*{-2}{2}{-40}{40}
    \draw[Bode lines,domain=-2:2,samples=150,smooth]
      plot (\x,{20*ln(abs(#1*sqrt(1+(#3*pow(10,\x))^2)/sqrt(1+(#2*#3*pow(10,\x))^2)))/ln(10)});
    \draw[asymp lines,dashed] ({-ln(#3)/ln(10)},-40) -- ({-ln(#3)/ln(10)},40);
    \draw[asymp lines,dashed] ({-ln(#2*#3)/ln(10)},-40) -- ({-ln(#2*#3)/ln(10)},40);
  \end{tikzpicture}
  \vspace{2mm}
  \begin{tikzpicture}[x=1.7cm,y=.025cm]
    \UniteDegre\OrdBode{45}\semilog*{-2}{2}{-90}{45}
    \draw[Bode lines,domain=-2:2,samples=150,smooth]
      plot (\x,{atan(#3*pow(10,\x))-atan(#2*#3*pow(10,\x))});
  \end{tikzpicture}
  \end{center}
}

