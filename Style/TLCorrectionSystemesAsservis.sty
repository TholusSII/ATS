\NewDocumentCommand{\TLBodeCorrecteurPID}{O{1} O{10} O{1} O{0.1}}{%
  % C(p)=K (1+Ti p)/(Ti p) (1+Td p)/(1+b Td p).
  \begin{center}
  \begin{tikzpicture}[x=1.7cm,y=.04cm]
    \UnitedB\OrdBode{20}\semilog*{-2}{2}{-60}{60}
    \draw[Bode lines,domain=-2:2,samples=170,smooth]
      plot (\x,{20*ln(abs(#1*sqrt(1+(#2*pow(10,\x))^2)/(#2*pow(10,\x))*sqrt(1+(#3*pow(10,\x))^2)/sqrt(1+(#4*#3*pow(10,\x))^2)))/ln(10)});
  \end{tikzpicture}
  \vspace{2mm}
  \begin{tikzpicture}[x=1.7cm,y=.022cm]
    \UniteDegre\OrdBode{45}\semilog*{-2}{2}{-180}{90}
    \draw[Bode lines,domain=-2:2,samples=170,smooth]
      plot (\x,{atan(#2*pow(10,\x))-90+atan(#3*pow(10,\x))-atan(#4*#3*pow(10,\x))});
  \end{tikzpicture}
  \end{center}
}

