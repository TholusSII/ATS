\NewDocumentCommand{\SAReperePerformances}{}{%
\begin{center}
\begin{tikzpicture}[>=Latex,font=\small]
  \node[draw,rounded corners,fill=SABlueBack,minimum width=28mm,minimum height=11mm] (stab) at (0,1.7) {Stabilité};
  \node[draw,rounded corners,fill=SAGreenBack,minimum width=28mm,minimum height=11mm] (rap) at (-2.6,-.3) {Rapidité};
  \node[draw,rounded corners,fill=SAOrangeBack,minimum width=28mm,minimum height=11mm] (prec) at (2.6,-.3) {Précision};
  \node[draw,circle,fill=white,minimum size=20mm,align=center] (sys) at (0,0) {Système\\asservi};
  \draw[->,thick] (sys)--(stab);
  \draw[->,thick] (sys)--(rap);
  \draw[->,thick] (sys)--(prec);
  \node[below=1.25cm of sys,draw,rounded corners,fill=SARedBack,minimum width=35mm,minimum height=10mm] (dep) {Dépassement};
  \draw[->,thick] (sys)--(dep);
\end{tikzpicture}
\end{center}}

