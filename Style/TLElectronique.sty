% AOP inverseur en TikZ élémentaire : aucune ancre op.+ ou op.-.
\newcommand{\TLAOPInverseur}{%
\typeout{TL-AOP-INVERSEUR-VERSION-E}%
\begin{center}
\begin{tikzpicture}[line width=0.8pt,font=\small]
  % Amplificateur opérationnel
  \draw (3,0.8) -- (3,3.2) -- (5.4,2) -- cycle;
  \node at (3.35,2.65) {$-$};
  \node at (3.35,1.35) {$+$};

  % Entrée inverseuse et résistance R1
  \draw (0,2.65) circle (2.2pt);
  \node[left] at (0,2.65) {$u_e$};
  \draw (0,2.65) -- (1,2.65);
  \draw (1,2.35) rectangle (2.2,2.95);
  \node[above] at (1.6,2.95) {$R_1$};
  \draw (2.2,2.65) -- (3,2.65);

  % Entrée non inverseuse à la masse
  \draw (3,1.35) -- (2.5,1.35) -- (2.5,0.55);
  \draw (2.15,0.55) -- (2.85,0.55);
  \draw (2.27,0.42) -- (2.73,0.42);
  \draw (2.39,0.29) -- (2.61,0.29);

  % Sortie
  \draw (5.4,2) -- (6.8,2);
  \draw (6.8,2) circle (2.2pt);
  \node[right] at (6.8,2) {$u_s$};

  % Boucle de rétroaction avec R2
  \draw (5.9,2) -- (5.9,4);
  \draw (4.2,3.7) rectangle (5.4,4.3);
  \node[above] at (4.8,4.3) {$R_2$};
  \draw (5.9,4) -- (5.4,4);
  \draw (4.2,4) -- (2.55,4) -- (2.55,2.65);
\end{tikzpicture}
\end{center}}

% AOP non inverseur en TikZ élémentaire : aucune ancre op.+ ou op.-.
\newcommand{\TLAOPNonInverseur}{%
\typeout{TL-AOP-NON-INVERSEUR-VERSION-E}%
\begin{center}
\begin{tikzpicture}[line width=0.8pt,font=\small]
  % Amplificateur opérationnel
  \draw (3,0.8) -- (3,3.2) -- (5.4,2) -- cycle;
  \node at (3.35,2.65) {$-$};
  \node at (3.35,1.35) {$+$};

  % Entrée non inverseuse
  \draw (0,1.35) circle (2.2pt);
  \node[left] at (0,1.35) {$u_e$};
  \draw (0,1.35) -- (3,1.35);

  % Sortie
  \draw (5.4,2) -- (6.8,2);
  \draw (6.8,2) circle (2.2pt);
  \node[right] at (6.8,2) {$u_s$};

  % Nœud inverseur
  \draw (3,2.65) -- (2.4,2.65);
  \fill (2.4,2.65) circle (1.3pt);

  % Résistance R1 vers la masse
  \draw (2.4,2.65) -- (2.4,1.9);
  \draw (2.1,0.9) rectangle (2.7,1.9);
  \node[left] at (2.1,1.4) {$R_1$};
  \draw (2.4,0.9) -- (2.4,0.55);
  \draw (2.05,0.55) -- (2.75,0.55);
  \draw (2.17,0.42) -- (2.63,0.42);
  \draw (2.29,0.29) -- (2.51,0.29);

  % Résistance R2 de rétroaction
  \draw (5.9,2) -- (5.9,4);
  \draw (4.2,3.7) rectangle (5.4,4.3);
  \node[above] at (4.8,4.3) {$R_2$};
  \draw (5.9,4) -- (5.4,4);
  \draw (4.2,4) -- (2.4,4) -- (2.4,2.65);
\end{tikzpicture}
\end{center}}

