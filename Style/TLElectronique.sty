% Source de tension explicite. Le décalage de repère évite les calculs
% arithmétiques directement placés dans les coordonnées TikZ, incompatibles
% avec certaines anciennes versions de PGF/TikZ distribuées par MiKTeX.
\newcommand{\TLSourceTensionVerticale}[3]{%
  \begin{scope}[shift={(#1,#2)}]
    \draw (0,0) -- (0,1.25);
    \draw (0,2.75) -- (0,4);
    \draw (0,2) circle (0.75);
    \node at (0,2.28) {$+$};
    \node at (0,1.72) {$-$};
    \node[left] at (-0.75,2) {#3};
  \end{scope}
}

% Pont diviseur : résistances conservées en circuitikz.
\newcommand{\TLPontDiviseur}{%
\begin{center}
\begin{circuitikz}[european resistors]
\TLSourceTensionVerticale{0}{0}{$E$}
\draw (0,4) to[R,l=$R_1$] (3,4) -- (3,2)
      to[R,l=$R_2$] (3,0) -- (0,0);
\draw (3,2) -- (4.2,2);
\node[ocirc] at (4.2,2) {};
\node[right] at (4.2,2) {$u_s$};
\end{circuitikz}
\end{center}}

