\newcommand{\TLAlgorithmeEuler}{%
\begin{tikzpicture}[node distance=7mm,>=Latex,
box/.style={draw,rounded corners,align=center,minimum width=4.4cm,minimum height=8mm},
term/.style={draw,ellipse,align=center,minimum width=3cm}]
\node[term] (d) {Données : $t_0,y_0,h,N$};
\node[box,below=of d] (i) {$k\leftarrow0$};
\node[box,below=of i] (c) {Calculer $y_{k+1}=y_k+h f(t_k,y_k)$};
\node[box,below=of c] (t) {$t_{k+1}=t_k+h$};
\node[box,below=of t] (inc) {$k\leftarrow k+1$};
\node[term,below=of inc] (f) {Fin si $k=N$};
\draw[->] (d)--(i);\draw[->](i)--(c);\draw[->](c)--(t);\draw[->](t)--(inc);\draw[->](inc)--(f);
\draw[->] (inc.east)--++(1,0)|-(c.east);
\end{tikzpicture}}

\newcommand{\TLSchemaEtatOrdreDeux}{%
\begin{tikzpicture}[>=Latex,node distance=13mm,
box/.style={draw,rounded corners,minimum width=3cm,minimum height=9mm,align=center}]
\node[box] (eq) {$\ddot q=F(t,q,\dot q)$};
\node[box,right=of eq] (etat) {$y_0=q$\\$y_1=\dot q$};
\node[box,right=of etat] (sys) {$\dot y_0=y_1$\\$\dot y_1=F(t,y_0,y_1)$};
\node[box,right=of sys] (euler) {Euler explicite\\sur chaque état};
\draw[->](eq)--(etat);\draw[->](etat)--(sys);\draw[->](sys)--(euler);
\end{tikzpicture}}

