\newcommand{\TLEulerGeometrique}{%
\begin{tikzpicture}[>=Latex,scale=.9]
  \draw[->] (-.2,0) -- (6.2,0) node[right] {$t$};
  \draw[->] (0,-.2) -- (0,3.6) node[above] {$y$};
