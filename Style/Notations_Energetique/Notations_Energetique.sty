%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
%	Notations en énergétique
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\NeedsTeXFormat{LaTeX2e}[1999/01/01]
\ProvidesPackage{Notations_Energetique}[2026/08/04]

% Chargement des extensions requises
\RequirePackage{ifthen}
\RequirePackage{xargs}
\RequirePackage{mathrsfs}

% Dans le cours MCC, les deux éléments nécessaires (\f et le booléen associé)
% sont fournis par le moteur afin d'éviter le chargement de l'ancienne
% bibliothèque Notations_Maths, qui redéfinit notamment \j.
\makeatletter
\@ifundefined{TLMCCMathCompatibilityReady}{%
  \@ifpackageloaded{Notations_Maths}{}{%
    \input{../../Style/Notations_Maths/Notations_Maths.sty}%
  }%
}{}
\makeatother

% Initialisation des booléens
\newboolean{boolRaccourcisEnergetique}
\setboolean{boolRaccourcisEnergetique}{true}

% Option de désactivation des raccourcis, sans commande interne contenant @.
\newif\ifTLEnergRaccourcis
\TLEnergRaccourcistrue
\DeclareOption{noRaccourci}{\TLEnergRaccourcisfalse}
\ProcessOptions\relax

\newcommand*{\RafEnergRac}[1]{%
  \ifthenelse{\boolean{boolRaccourcisMaths}}{#1}{}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Commandes et environnements personnalisés

% PUISSANCE
%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\PCallig}{\ensuremath{\mathscr{P}}}
\newcommandx{\puissance}[4][2=,4=]{{%
  \ifthenelse{\equal{#2}{}}
    {\newcommand*{\notationActionMecaniquePourP}{\ensuremath{#1}}}
    {\newcommand*{\notationActionMecaniquePourP}{\ensuremath{#1\mapsto#2}}}%
  \ifthenelse{\equal{#3}{}}
    {\newcommand*{\notationFinIndicePuissanceCommeParExempleReferentiel}{}}
    {\newcommand*{\notationFinIndicePuissanceCommeParExempleReferentiel}{\ensuremath{,#3}}}%
  \ifthenelse{\equal{#4}{}}
    {\ensuremath{\PCallig_{\notationActionMecaniquePourP\notationFinIndicePuissanceCommeParExempleReferentiel}}}
    {\f{\PCallig_{\notationActionMecaniquePourP\notationFinIndicePuissanceCommeParExempleReferentiel}}{#4}}%
}}

\newcommand*{\puissanceMutuelle}[2]{\ensuremath{\PCallig_{#1\leftrightarrow#2}}}
\newcommand*{\puissanceMutuelles}{\puissanceMutuelle}
\newcommand*{\pMutuelle}{\puissanceMutuelle}
\newcommand*{\pMutuelles}{\puissanceMutuelle}

\newcommand*{\Pint}[1]{%
  \ensuremath{%
    \ifthenelse{\equal{#1}{}}
      {\PCallig_{int}}
      {\f{\PCallig_{int}}{#1}}%
  }%
}

\ifTLEnergRaccourcis
  \renewcommand{\P}{\puissance}
\fi

% TRAVAIL / ÉNERGIE
%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommandx{\travail}[3][3=]{%
  \ensuremath{W_{#1\ifthenelse{\equal{#2}{}}{}{,#2\ifthenelse{\equal{#3}{}}{}{\rightarrow#3}}}}%
}

\newcommand*{\eCinetique}[2]{\ensuremath{T_{(#1/#2)}}}
\newcommand*{\eCin}{\eCinetique}

\ifTLEnergRaccourcis
  \newcommand{\Wk}{\travail}
\fi

\endinput
