\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{CouvertureCours}[2026/08/01 Couverture standard des polys de cours]

\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{etoolbox}
\RequirePackage{eso-pic}

\usetikzlibrary{calc}
\input{TLDoisneauPhoto.tex}

% Copie indépendante de \includegraphics. Les fichiers de cours historiques
% peuvent redéfinir temporairement \includegraphics pour retirer leur ancienne
% couverture : cette copie garantit que les images de la nouvelle couverture ne
% sont jamais interceptées par ce mécanisme.
\NewCommandCopy\TLCoverIncludeGraphics\includegraphics

\definecolor{TLCoverBlue}{RGB}{0,74,146}
\definecolor{TLCoverGreen}{RGB}{151,183,63}
\definecolor{TLCoverOrange}{RGB}{235,104,0}
\definecolor{TLCoverFooterBackground}{RGB}{232,239,242}

\newcommand{\TLHeroImage}{}
\newcommand{\TLPreviewImage}{}
\newcommand{\TLCycleText}{}
\newcommand{\TLCourseTitle}{}
\newcommand{\TLFooterText}{Lycée Robert Doisneau - ATS}
\newcommand{\TLFooterAuthor}{Thomas Lusseau}
\newcommand{\TLCoverContentsBody}{}

% #1 : image du bandeau supérieur
% #2 : illustration centrale
% #3 : texte du cycle
% #4 : titre du cours
% #5 : établissement et formation affichés dans le pied de page
% #6 : auteur affiché sous l'établissement
\newcommand{\TLCourseCoverSetup}[6]{%
  \gdef\TLHeroImage{#1}%
  \gdef\TLPreviewImage{#2}%
  \gdef\TLCycleText{#3}%
  \gdef\TLCourseTitle{#4}%
  \gdef\TLFooterText{#5}%
  \gdef\TLFooterAuthor{#6}%
}

\newcommand{\TLCourseCoverContents}[1]{%
  \gdef\TLCoverContentsBody{#1}%
}

% Une référence absente lors de la toute première passe est remplacée par un
% tiret. La deuxième passe affiche automatiquement le numéro de page sans
% produire d'avertissement « undefined reference ».
\makeatletter
\newcommand{\TLCoursePageReference}[1]{%
  \@ifundefined{r@#1}{--}{\pageref{#1}}%
}
\makeatother

\newcommand{\TLCourseContentsLine}[3]{%
  \par\noindent
  \begin{minipage}[t]{8mm}
    \raggedright\bfseries #1
  \end{minipage}%
  \begin{minipage}[t]{39mm}
    \raggedright\bfseries #2
  \end{minipage}%
  \hfill\textbf{\TLCoursePageReference{#3}}\par
  \vspace{1.1mm}%
}

% -----------------------------------------------------------------------------
% Pied de page commun
% -----------------------------------------------------------------------------
\newsavebox{\TLDoisneauPhotoBox}
\newsavebox{\TLFooterCompositeBox}
\newif\ifTLCourseFooterInstalled
\TLCourseFooterInstalledfalse

\newcommand{\TLFooterPhoto}{%
  \begin{tikzpicture}[baseline=(current bounding box.south)]
    \path[rounded corners=2.2mm,fill=white,opacity=.78]
      (0,0) rectangle (30mm,13mm);

    \begin{scope}
      \clip[rounded corners=2.2mm] (0,0) rectangle (30mm,13mm);
      \node[anchor=south west,inner sep=0pt] at (1.2mm,.5mm)
        {\usebox{\TLDoisneauPhotoBox}};

      % Fondu progressif sur les quatre bords.
      \fill[TLCoverFooterBackground,opacity=.68] (0,0) rectangle (1.0mm,13mm);
      \fill[TLCoverFooterBackground,opacity=.42] (1.0mm,0) rectangle (2.1mm,13mm);
      \fill[TLCoverFooterBackground,opacity=.20] (2.1mm,0) rectangle (3.2mm,13mm);
      \fill[TLCoverFooterBackground,opacity=.20] (26.8mm,0) rectangle (27.9mm,13mm);
      \fill[TLCoverFooterBackground,opacity=.42] (27.9mm,0) rectangle (29.0mm,13mm);
      \fill[TLCoverFooterBackground,opacity=.68] (29.0mm,0) rectangle (30mm,13mm);
      \fill[TLCoverFooterBackground,opacity=.38] (0,0) rectangle (30mm,.8mm);
      \fill[TLCoverFooterBackground,opacity=.22] (0,.8mm) rectangle (30mm,1.6mm);
      \fill[TLCoverFooterBackground,opacity=.22] (0,11.4mm) rectangle (30mm,12.2mm);
      \fill[TLCoverFooterBackground,opacity=.38] (0,12.2mm) rectangle (30mm,13mm);
    \end{scope}

    \draw[white,opacity=.90,line width=.4pt,rounded corners=2.2mm]
      (0,0) rectangle (30mm,13mm);
  \end{tikzpicture}%
}

\newcommand{\TLDrawCourseFooter}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[TLCoverFooterBackground]
      (current page.south west)
      rectangle
      ([yshift=18mm]current page.south east);

    \node[
      anchor=south west,
      inner sep=0pt,
      xshift=4mm,
      yshift=2.3mm
    ] at (current page.south west) {\usebox{\TLFooterCompositeBox}};

    \node[
      anchor=south east,
      xshift=-9mm,
      yshift=7.0mm,
      text=TLCoverBlue,
      font=\sffamily\bfseries\fontsize{11.5}{12.5}\selectfont
    ] at (current page.south east) {\TLFooterText};

    \node[
      anchor=south east,
      xshift=-9mm,
      yshift=3.1mm,
      text=TLCoverBlue,
      font=\sffamily\fontsize{8.2}{9}\selectfont
    ] at (current page.south east) {\TLFooterAuthor};
  \end{tikzpicture}%
}

\newcommand{\TLCourseFooter}{%
  \ifTLCourseFooterInstalled
  \else
    \global\TLCourseFooterInstalledtrue
    \sbox{\TLDoisneauPhotoBox}{\TLRobertDoisneauPhoto}%
    \sbox{\TLFooterCompositeBox}{\TLFooterPhoto}%
    \AddToShipoutPictureBG{\TLDrawCourseFooter}%
  \fi
}

% -----------------------------------------------------------------------------
% Couverture
% -----------------------------------------------------------------------------
\newcommand{\TLDrawCourseCover}{%
  \begin{tikzpicture}[remember picture,overlay]
    % Bandeau supérieur en pleine largeur, sans marge blanche.
    \node[anchor=north west,inner sep=0pt]
      at (current page.north west)
      {\TLCoverIncludeGraphics[
        width=\paperwidth,
        height=62mm
      ]{\TLHeroImage}};

    \fill[white,opacity=.86]
      ([yshift=-51mm]current page.north west)
      rectangle
      ([xshift=-16mm,yshift=-67mm]current page.north east);

    \node[
      anchor=west,
      xshift=14mm,
      yshift=-59mm,
      text=TLCoverBlue,
      align=left,
      text width=.80\paperwidth,
      font=\sffamily\bfseries\fontsize{15}{18}\selectfont
    ] at (current page.north west) {\TLCourseTitle};

    % Illustration centrale légèrement agrandie.
    \node[anchor=north,inner sep=0pt,xshift=-38mm,yshift=-81mm]
      at (current page.north)
      {\IfFileExists{\TLPreviewImage}{%
        \TLCoverIncludeGraphics[width=80mm,height=52mm,keepaspectratio]{\TLPreviewImage}%
      }{}};

    \node[
      anchor=north west,
      inner sep=0pt,
      xshift=136mm,
      yshift=-84mm,
      text width=56mm,
      align=left,
      text=TLCoverBlue,
      font=\sffamily\fontsize{6.7}{8.2}\selectfont
    ] at (current page.north west)
      {\begin{minipage}[t]{56mm}\TLCoverContentsBody\end{minipage}};

    \node[
      anchor=north,
      yshift=-153mm,
      text=TLCoverOrange,
      align=center,
      text width=130mm,
      font=\rmfamily\fontsize{15}{20}\selectfont
    ] at (current page.north) {\TLCycleText};

    \node[
      anchor=north,
      yshift=-205mm,
      text=TLCoverGreen,
      align=center,
      text width=150mm,
      font=\sffamily\bfseries\fontsize{15}{19}\selectfont
    ] at (current page.north) {\TLCourseTitle};
  \end{tikzpicture}%
}

% La page de couverture est la prochaine page effectivement expédiée. Tous les
% éléments utilisent le même calque et restent donc sur la page du bandeau.
\newcommand{\TLCourseCover}{%
  \setcounter{page}{1}%
  \thispagestyle{empty}%
  \AddToShipoutPictureFG*{\TLDrawCourseCover}%
  \null\vfill
  \clearpage
  \setcounter{page}{2}%
}
