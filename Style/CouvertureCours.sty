\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{CouvertureCours}[2026/08/01 Couverture standard des polys de cours]

\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{etoolbox}

\usetikzlibrary{calc}

\definecolor{TLCoverBlue}{RGB}{0,74,146}
\definecolor{TLCoverGreen}{RGB}{151,183,63}
\definecolor{TLCoverOrange}{RGB}{235,104,0}
\definecolor{TLCoverFooterBackground}{RGB}{232,239,242}

\newcommand{\TLHeroImage}{}
\newcommand{\TLPreviewImage}{}
\newcommand{\TLCycleText}{}
\newcommand{\TLCourseTitle}{}
\newcommand{\TLFooterLogo}{}
\newcommand{\TLFooterText}{}
\newcommand{\TLCoverContentsBody}{}

% #1 : image du bandeau supérieur
% #2 : illustration centrale
% #3 : texte du cycle
% #4 : titre du cours
% #5 : logo du pied de page
% #6 : texte du pied de page
\newcommand{\TLCourseCoverSetup}[6]{%
  \gdef\TLHeroImage{#1}%
  \gdef\TLPreviewImage{#2}%
  \gdef\TLCycleText{#3}%
  \gdef\TLCourseTitle{#4}%
  \gdef\TLFooterLogo{#5}%
  \gdef\TLFooterText{#6}%
}

\newcommand{\TLCourseCoverContents}[1]{%
  \gdef\TLCoverContentsBody{#1}%
}

\newcommand{\TLCourseContentsLine}[3]{%
  \par\noindent
  \begin{minipage}[t]{8mm}
    \raggedright\bfseries #1
  \end{minipage}%
  \begin{minipage}[t]{39mm}
    \raggedright\bfseries #2
  \end{minipage}%
  \hfill\textbf{\pageref{#3}}\par
  \vspace{1.1mm}%
}

% Pied de page commun à toutes les pages du poly.
\newcommand{\TLCourseFooter}{%
  \def\TLCurrentFooterLogo{%
    \IfFileExists{\TLFooterLogo}{%
      \includegraphics[height=7mm]{\TLFooterLogo}%
    }{}%
  }%
  \def\TLCurrentFooterText{%
    \textcolor{TLCoverBlue}{\sffamily\small \TLFooterText}%
  }%
  \lefoot[\TLCurrentFooterLogo]{\TLCurrentFooterLogo}%
  \lofoot[\TLCurrentFooterLogo]{\TLCurrentFooterLogo}%
  \refoot[\TLCurrentFooterText]{\TLCurrentFooterText}%
  \rofoot[\TLCurrentFooterText]{\TLCurrentFooterText}%
}

% Couverture entièrement positionnée en coordonnées absolues. Elle occupe une
% seule page et n'appelle jamais \tableofcontents : aucun feuillet supplémentaire
% n'est créé.
\newcommand{\TLCourseCover}{%
  \begin{titlepage}
    \thispagestyle{empty}%
    \begin{tikzpicture}[remember picture,overlay]

      \node[anchor=north west,inner sep=0pt,xshift=4mm,yshift=-4mm]
        at (current page.north west)
        {\includegraphics[
          width=\dimexpr\paperwidth-8mm\relax,
          height=62mm
        ]{\TLHeroImage}};

      \fill[white,opacity=.86]
        ([xshift=4mm,yshift=-51mm]current page.north west)
        rectangle
        ([xshift=-16mm,yshift=-67mm]current page.north east);

      \node[
        anchor=west,
        xshift=14mm,
        yshift=-59mm,
        text=TLCoverBlue,
        align=left,
        text width=.80\paperwidth,
        font=\sffamily\bfseries\fontsize{15}{18}\selectfont
      ] at (current page.north west) {\TLCourseTitle};

      \node[anchor=north,inner sep=0pt,xshift=-38mm,yshift=-82mm]
        at (current page.north)
        {\IfFileExists{\TLPreviewImage}{%
          \includegraphics[width=66mm,height=43mm,keepaspectratio]{\TLPreviewImage}%
        }{}};

      \node[
        anchor=north west,
        inner sep=0pt,
        xshift=136mm,
        yshift=-84mm,
        text width=56mm,
        align=left,
        text=TLCoverBlue,
        font=\sffamily\fontsize{6.7}{8.2}\selectfont
      ] at (current page.north west)
        {\begin{minipage}[t]{56mm}\TLCoverContentsBody\end{minipage}};

      \node[
        anchor=north,
        yshift=-153mm,
        text=TLCoverOrange,
        align=center,
        text width=130mm,
        font=\rmfamily\fontsize{15}{20}\selectfont
      ] at (current page.north) {\TLCycleText};

      \node[
        anchor=north,
        yshift=-205mm,
        text=TLCoverGreen,
        align=center,
        text width=150mm,
        font=\sffamily\bfseries\fontsize{15}{19}\selectfont
      ] at (current page.north) {\TLCourseTitle};

      \fill[TLCoverFooterBackground]
        (current page.south west)
        rectangle
        ([yshift=15mm]current page.south east);

      \node[anchor=south west,inner sep=0pt,xshift=4mm,yshift=1mm]
        at (current page.south west)
        {\IfFileExists{\TLFooterLogo}{%
          \includegraphics[height=12mm]{\TLFooterLogo}%
        }{}};

      \node[
        anchor=south east,
        xshift=-8mm,
        yshift=5mm,
        text=TLCoverBlue,
        font=\sffamily\scriptsize
      ] at (current page.south east) {\TLFooterText};

    \end{tikzpicture}%
    \null\vfill
  \end{titlepage}%
}
