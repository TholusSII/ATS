\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{CouvertureCours}[2026/08/01 Couverture standard des polys de cours]

\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{etoolbox}
\RequirePackage{eso-pic}

\usetikzlibrary{calc,shadows.blur}
\input{TLDoisneauPhoto.tex}

\definecolor{TLCoverBlue}{RGB}{0,74,146}
\definecolor{TLCoverGreen}{RGB}{151,183,63}
\definecolor{TLCoverOrange}{RGB}{235,104,0}
\definecolor{TLCoverFooterBackground}{RGB}{232,239,242}

\newcommand{\TLHeroImage}{}
\newcommand{\TLPreviewImage}{}
\newcommand{\TLCycleText}{}
\newcommand{\TLCourseTitle}{}
\newcommand{\TLFooterText}{Lycée Robert Doisneau - ATS}
\newcommand{\TLCoverContentsBody}{}

% #1 : image du bandeau supérieur
% #2 : illustration centrale
% #3 : texte du cycle
% #4 : titre du cours
% #5 : texte du pied de page
\newcommand{\TLCourseCoverSetup}[5]{%
  \gdef\TLHeroImage{#1}%
  \gdef\TLPreviewImage{#2}%
  \gdef\TLCycleText{#3}%
  \gdef\TLCourseTitle{#4}%
  \gdef\TLFooterText{#5}%
}

\newcommand{\TLCourseCoverContents}[1]{%
  \gdef\TLCoverContentsBody{#1}%
}

\newcommand{\TLCourseContentsLine}[3]{%
  \par\noindent
  \begin{minipage}[t]{8mm}
    \raggedright\bfseries #1
  \end{minipage}%
  \begin{minipage}[t]{39mm}
    \raggedright\bfseries #2
  \end{minipage}%
  \hfill\textbf{\pageref{#3}}\par
  \vspace{1.1mm}%
}

% -----------------------------------------------------------------------------
% Pied de page commun
% -----------------------------------------------------------------------------
% Le pied de page est ajouté au calque de fond de chaque page. Il reste présent
% même lorsque kaobook change le style de page pour un chapitre, une page paire
% ou une page impaire.
\newsavebox{\TLDoisneauPhotoBox}
\newsavebox{\TLFooterCompositeBox}
\newif\ifTLCourseFooterInstalled
\TLCourseFooterInstalledfalse

\newcommand{\TLFooterPhoto}{%
  \begin{tikzpicture}[baseline=(current bounding box.south)]
    % Ombre très légère derrière la photographie.
    \path[
      rounded corners=2mm,
      fill=white,
      blur shadow={shadow blur steps=5,shadow opacity=.18,shadow xshift=.4mm,shadow yshift=-.4mm}
    ] (0,0) rectangle (27mm,12mm);

    % Découpe arrondie de la photo.
    \begin{scope}
      \clip[rounded corners=2mm] (0,0) rectangle (27mm,12mm);
      \node[anchor=south west,inner sep=0pt] at (1mm,.3mm)
        {\usebox{\TLDoisneauPhotoBox}};

      % Fondu progressif sur les bords, obtenu par plusieurs voiles de fond.
      \fill[TLCoverFooterBackground,opacity=.58] (0,0) rectangle (1.0mm,12mm);
      \fill[TLCoverFooterBackground,opacity=.34] (1.0mm,0) rectangle (2.0mm,12mm);
      \fill[TLCoverFooterBackground,opacity=.16] (2.0mm,0) rectangle (3.0mm,12mm);
      \fill[TLCoverFooterBackground,opacity=.16] (24mm,0) rectangle (25mm,12mm);
      \fill[TLCoverFooterBackground,opacity=.34] (25mm,0) rectangle (26mm,12mm);
      \fill[TLCoverFooterBackground,opacity=.58] (26mm,0) rectangle (27mm,12mm);
    \end{scope}

    % Filet blanc discret pour fondre l'image dans le bandeau.
    \draw[white,opacity=.82,line width=.35pt,rounded corners=2mm]
      (0,0) rectangle (27mm,12mm);
  \end{tikzpicture}%
}

\newcommand{\TLCourseFooter}{%
  \ifTLCourseFooterInstalled
  \else
    \global\TLCourseFooterInstalledtrue
    \sbox{\TLDoisneauPhotoBox}{\TLRobertDoisneauPhoto}%
    \sbox{\TLFooterCompositeBox}{\TLFooterPhoto}%
    \AddToShipoutPictureBG{%
      \begin{tikzpicture}[remember picture,overlay]
        \fill[TLCoverFooterBackground]
          (current page.south west)
          rectangle
          ([yshift=18mm]current page.south east);

        \node[
          anchor=south west,
          inner sep=0pt,
          xshift=4mm,
          yshift=2.6mm
        ] at (current page.south west) {\usebox{\TLFooterCompositeBox}};

        \node[
          anchor=south east,
          xshift=-9mm,
          yshift=4.4mm,
          text=TLCoverBlue,
          align=right
        ] at (current page.south east) {%
          {\sffamily\bfseries\fontsize{10.5}{11.5}\selectfont
            Lycée Robert Doisneau}\[-.5mm]
          {\sffamily\fontsize{7.8}{8.5}\selectfont ATS}%
        };
      \end{tikzpicture}%
    }%
  \fi
}

% -----------------------------------------------------------------------------
% Couverture
% -----------------------------------------------------------------------------
% La couverture est entièrement positionnée en coordonnées absolues et n'appelle
% jamais \tableofcontents. Elle est explicitement imposée comme page 1 ; le
% document reprend ensuite en page 2, indépendamment des choix recto-verso de
% kaobook.
\newcommand{\TLCourseCover}{%
  \clearpage
  \setcounter{page}{1}%
  \begin{titlepage}
    \thispagestyle{empty}%
    \begin{tikzpicture}[remember picture,overlay]

      \node[anchor=north west,inner sep=0pt,xshift=4mm,yshift=-4mm]
        at (current page.north west)
        {\includegraphics[
          width=\dimexpr\paperwidth-8mm\relax,
          height=62mm
        ]{\TLHeroImage}};

      \fill[white,opacity=.86]
        ([xshift=4mm,yshift=-51mm]current page.north west)
        rectangle
        ([xshift=-16mm,yshift=-67mm]current page.north east);

      \node[
        anchor=west,
        xshift=14mm,
        yshift=-59mm,
        text=TLCoverBlue,
        align=left,
        text width=.80\paperwidth,
        font=\sffamily\bfseries\fontsize{15}{18}\selectfont
      ] at (current page.north west) {\TLCourseTitle};

      \node[anchor=north,inner sep=0pt,xshift=-38mm,yshift=-82mm]
        at (current page.north)
        {\IfFileExists{\TLPreviewImage}{%
          \includegraphics[width=66mm,height=43mm,keepaspectratio]{\TLPreviewImage}%
        }{}};

      \node[
        anchor=north west,
        inner sep=0pt,
        xshift=136mm,
        yshift=-84mm,
        text width=56mm,
        align=left,
        text=TLCoverBlue,
        font=\sffamily\fontsize{6.7}{8.2}\selectfont
      ] at (current page.north west)
        {\begin{minipage}[t]{56mm}\TLCoverContentsBody\end{minipage}};

      \node[
        anchor=north,
        yshift=-153mm,
        text=TLCoverOrange,
        align=center,
        text width=130mm,
        font=\rmfamily\fontsize{15}{20}\selectfont
      ] at (current page.north) {\TLCycleText};

      \node[
        anchor=north,
        yshift=-205mm,
        text=TLCoverGreen,
        align=center,
        text width=150mm,
        font=\sffamily\bfseries\fontsize{15}{19}\selectfont
      ] at (current page.north) {\TLCourseTitle};

    \end{tikzpicture}%
    \null\vfill
  \end{titlepage}%
  \clearpage
  \setcounter{page}{2}%
}
