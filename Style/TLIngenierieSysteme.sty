  \draw[->,thick] (r1)--node[above,sloped]{«deriveReqt»}(r0);
  \draw[->,thick] (r2)--node[right]{«deriveReqt»}(r0);
  \draw[->,thick] (r3)--node[above,sloped]{«deriveReqt»}(r0);
\end{tikzpicture}}
\end{center}}

\NewDocumentCommand{\ISBDDIBD}{}{%
\begin{center}
\begin{minipage}[t]{.48\linewidth}
\centering\textbf{BDD : composition}\par\medskip
\resizebox{\linewidth}{!}{%
\begin{tikzpicture}[font=\scriptsize,node distance=7mm]
  \node[ISbloc] (s) {Système};
  \node[ISbloc,below left=of s] (pc) {Partie\\commande};
  \node[ISbloc,below right=of s] (po) {Partie\\opérative};
  \draw[thick] (s)--(pc);\draw[thick] (s)--(po);
\end{tikzpicture}}
\end{minipage}\hfill
\begin{minipage}[t]{.48\linewidth}
\centering\textbf{IBD : échanges internes}\par\medskip
\resizebox{\linewidth}{!}{%
\begin{tikzpicture}[font=\scriptsize,node distance=11mm]
  \node[ISbloc] (c) {Commande};
  \node[ISbloc,right=of c] (a) {Actionneur};
  \node[ISbloc,below=of a] (cap) {Capteur};
  \draw[ISlink] (c)--node[above]{ordre}(a);
  \draw[ISlink] (a)--node[right]{grandeur}(cap);
  \draw[ISlink] (cap)--node[below,sloped]{mesure}(c);
\end{tikzpicture}}
\end{minipage}
\end{center}}

\NewDocumentCommand{\ISChaineFonctionnelle}{}{%
\begin{center}
\resizebox{.98\linewidth}{!}{%
\begin{tikzpicture}[>=Latex,font=\scriptsize,node distance=5mm]
  \node[ISfonction] (acq) {Acquérir};
  \node[ISfonction,right=of acq] (trait) {Traiter};
  \node[ISfonction,right=of trait] (comm) {Communiquer};
  \node[ISfonction,below=12mm of acq] (alim) {Alimenter};
  \node[ISfonction,right=of alim] (dist) {Distribuer};
  \node[ISfonction,right=of dist] (conv) {Convertir};
  \node[ISfonction,right=of conv] (trans) {Transmettre};
  \node[ISfonction,right=of trans] (agir) {Agir};
  \draw[ISlink] (acq)--(trait)--(comm);
  \draw[ISlink] (alim)--(dist)--(conv)--(trans)--(agir);
  \draw[ISlink] (trait.south)--(dist.north);
  \node[left=3mm of acq,font=\bfseries] {Information};
  \node[left=3mm of alim,font=\bfseries] {Énergie};
\end{tikzpicture}}
\end{center}}

